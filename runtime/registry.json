  "interaction_route_activation": [
    {
      "route": "combat",
      "activation_when": "PHASE=COMBAT，或存在ACTIVE战斗/遭遇且输入为当前战斗行动",
      "priority": 1
    },
    {
      "route": "companion_episode",
      "activation_when": "PHASE=COMPANION_EPISODE，或明确进入/继续某个固定伙伴篇章节点",
      "priority": 2
    },
    {
      "route": "hunting",
      "activation_when": "明确猎魂、寻怪、选择猎魂区域、继续搜索、为自己/伙伴寻找魂环，且尚未进入ACTIVE战斗",
      "priority": 3
    },
    {
      "route": "economy_transaction",
      "activation_when": "明确吃饭、外出用餐、家中做饭、买药或其他E00标准交易",
      "priority": 4
    },
    {
      "route": "recovery",
      "activation_when": "明确游戏内睡眠、休息、调息、使用已拥有恢复品，或询问当前恢复方式",
      "priority": 5
    },
    {
      "route": "ordinary_world_action",
      "activation_when": "其余开放世界对话、社交、旅行、等待、游戏内普通修炼与普通行动",
      "priority": 99,
      "fallback": true
    }
  ],
